[Unit]
Description=Pi-hole maintenance controlled update
After=network-online.target pihole-FTL.service unbound.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/pihole-maintenance-runner update
TimeoutStartSec=120min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/backups/pihole-suite /var/lib/pihole-suite/jobs /run/lock
